generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              String            @id
  email           String            @unique
  createdAt       DateTime          @default(now())
  lotes           Lote[]
  establecimientos Establecimiento[]
}

/// Establecimiento (campo) del productor: agrupa lotes bajo una unidad de
/// gestión. Un usuario puede tener varios establecimientos y cada
/// establecimiento muchos lotes.
model Establecimiento {
  id        String   @id @default(uuid())
  nombre    String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lotes     Lote[]
  createdAt DateTime @default(now())

  @@index([userId])
}

model Lote {
  id                String           @id @default(uuid())
  nombre            String
  areaHectareas     Float
  scoreHistorico    Int?
  poligonoGeoJSON   Json
  dataProcesada     Json
  createdAt         DateTime         @default(now())
  userId            String
  user              User             @relation(fields: [userId], references: [id])
  /// Relación opcional: un lote puede no pertenecer aún a un establecimiento
  /// (compatibilidad con lotes creados antes de la feature). `SetNull` al
  /// borrar el establecimiento mantiene el lote pero lo desagrupa.
  establecimientoId String?
  establecimiento   Establecimiento? @relation(fields: [establecimientoId], references: [id], onDelete: SetNull)
  analisis          AnalisisLote?
  reportes          Reporte[]

  @@index([establecimientoId])
}

/// Reporte PDF generado por el usuario (Centro de Descargas). El archivo
/// binario vive en Supabase Storage (bucket privado); acá guardamos sólo la
/// metadata + el `urlStorage` (path relativo dentro del bucket) para listarlo
/// y servir URLs firmadas de descarga.
///
/// La relación con `Lote` es opcional y usa `onDelete: SetNull`: borrar un lote
/// NO debe borrar el reporte histórico ni su PDF. Para no perder el contexto
/// cuando el lote/establecimiento desaparece, se persiste `establecimiento`
/// como string plano (snapshot del nombre al momento de generar el reporte).
model Reporte {
  id              String   @id @default(uuid())
  nombre          String
  establecimiento String?
  urlStorage      String
  userId          String
  loteId          String?
  lote            Lote?    @relation(fields: [loteId], references: [id], onDelete: SetNull)
  /// Soft delete: el reporte se oculta de la vista del usuario sin borrar la
  /// fila ni el PDF en Storage, preservando historial y trazabilidad del SaaS.
  isDeleted       Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([loteId])
}

/// Resultado cacheado del análisis espacial del lote contra Google Earth
/// Engine (elevación SRTM + historial de inundaciones GFD).
///
/// Patrón cache-aside: se recalcula contra GEE sólo si la geometría del
/// lote cambió (`geomHash`) o si el registro venció el TTL. Para los
/// datasets actuales (SRTM 2000, GFD 2000–2018) el dato es esencialmente
/// estático, así que el disparador real de recálculo es el cambio de
/// geometría, no el tiempo — el TTL es sólo una red de seguridad.
model AnalisisLote {
  id                String   @id @default(uuid())
  loteId            String   @unique
  lote              Lote     @relation(fields: [loteId], references: [id], onDelete: Cascade)
  elevacion         Float?
  eventosInundacion Int      @default(0)
  inundaciones      Json? // Detalle de eventos: [{ began, ended, duracionDias, dfoId }]
  geomHash          String? // Para invalidación por cambio de geometría
  fuentes           Json? // { srtm: "USGS/SRTMGL1_003", gfd: "GLOBAL_FLOOD_DB/MODIS_EVENTS/V1" }
  updatedAt         DateTime @updatedAt
}

/// Detección histórica de incendio activo / fuente de calor de NASA FIRMS.
///
/// Fuente: archivos CSV de FIRMS (https://firms.modaps.eosdis.nasa.gov/)
/// con datos de los sensores VIIRS a bordo de los satélites Suomi-NPP
/// (SNPP) y NOAA-20 (N20). Cada fila representa un "fire pixel" de
/// 375 m × 375 m detectado en una pasada del satélite.
///
/// Modelo agnóstico al satélite — usamos un único campo `satellite`
/// (`"N20"` / `"SNPP"`) para distinguir el origen. Todas las columnas
/// opcionales son `null`-able porque versiones futuras del producto
/// pueden agregar/quitar campos sin romper la ingesta.
///
/// La columna `geom` es `geometry(Point, 4326)` (postgis): la **única**
/// que se usa para queries espaciales (ST_DWithin, ST_Intersects, etc.).
/// `latitude` y `longitude` se mantienen como columnas planas para
/// trazabilidad y auditoría — `geom` se deriva de ellas con un UPDATE
/// post-carga.
///
/// Prisma no entiende `geometry` nativamente, así que la declaramos como
/// `Unsupported(...)`. Eso implica: no se puede leer/escribir desde el
/// cliente Prisma típico (`prisma.incendio.findMany`) — para eso hay que
/// usar `$queryRaw`. El cliente sí incluirá el resto de campos.
model Incendio {
  id         Int                                   @id @default(autoincrement())
  latitude   Float
  longitude  Float
  brightness Float?
  scan       Float?
  track      Float?
  acq_date   DateTime
  acq_time   String?
  satellite  String
  instrument String?
  confidence String?
  version    String?
  bright_t31 Float?
  frp        Float?
  daynight   String?
  type       Int?
  geom       Unsupported("geometry(Point, 4326)")?

  /// Índice GIST sobre `geom`: indispensable para que `ST_DWithin` y
  /// `ST_Intersects` rindan O(log N) en vez de full scan. Sin esto, una
  /// query "incendios a 5 km del lote" sobre 4M filas es inviable.
  @@index([geom], map: "idx_incendios_geom", type: Gist)
  /// Índice B-tree estándar sobre `acq_date` para filtros temporales
  /// (e.g. "incendios en el lote en el último año").
  @@index([acq_date])
  @@map("incendios")
}